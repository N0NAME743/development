# このファイルのみgit管理する。実際の値を入れた .env は絶対にコミットしないこと。

# --- AI Provider (Phase 3) ---
# Gemini / Anthropic / OpenAI のいずれか。AI_API_KEY を優先的に読む実装だが、
# プロバイダ固有の名前 (GEMINI_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY) でも動作する。
# 既定はGemini（AI_PROVIDER未設定時）。無料枠があり、既存のx_pipelineと同じキーを流用できる。
AI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# "gemini"（既定） | "anthropic" | "openai"
AI_PROVIDER=

# --- Discord (Phase 4) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# --- X API (Phase 5) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# --- 情報源: 記録_Research INBOX（既存のX→Notionパイプラインと同じNotion DB） ---
# 既存の workspace/x_pipeline/.env や Pi上の x-likes-notion/.env と同じ値を使う想定。
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
# AI査定プロパティがこの値の行だけをYAKUMOのリアクション対象にする
NOTION_AI_HANTEI_VALUE=🟢 IDEA BOXへ

# --- Day One（現在は不使用。docs/architecture.md 2章参照。将来案Aへ戻す場合のみ設定） ---
DAYONE_EXPORT_DIR=./data/dayone_exports

# --- 投稿ペース制御 ---
# 実際のX投稿は、前回投稿からこの分数以上経っていないと行われない
# （複数承認があっても連投しない。process_queue.py参照）
MIN_POST_INTERVAL_MINUTES=30

# --- 安全装置 ---
# true の間は、承認されてもXへは絶対に投稿しない。
# Phase 5をユーザーが明示的に有効化するまで true のままにすること。
DRY_RUN=true
