# X (Twitter) OAuth2. アクセストークンの期限切れは自動更新され、
# 更新後の値がこのファイルに書き戻される（chmod 600 推奨）。
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# Notion
NOTION_TOKEN=
# 保存先「記録_ResearchINBOX」データベースのdata_source_id
NOTION_DATA_SOURCE_ID=
# 「記録_IDEA from SNS」内のIDEA BOXデータベースのdata_source_id
# 未設定の場合、IDEA BOXへのコピーはスキップされる（INBOXへの保存は通常通り継続）
NOTION_IDEA_BOX_DATA_SOURCE_ID=

# Gemini
GEMINI_API_KEY=
