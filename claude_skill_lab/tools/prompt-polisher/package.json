{
  "name": "prompt-polisher",
  "displayName": "Prompt Polisher",
  "description": "選択したテキストを、生成AIに渡しやすい構造化プロンプトに整形する拡張機能",
  "version": "0.1.0",
  "private": true,
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:promptPolisher.polishSelection"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "promptPolisher.polishSelection",
        "title": "Prompt Polisher: 選択範囲をプロンプトに整形"
      }
    ],
    "keybindings": [
      {
        "command": "promptPolisher.polishSelection",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorHasSelection"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
