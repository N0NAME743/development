{% macro icon_phone() -%}
<svg class="btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
{%- endmacro %}

{% macro icon_pin() -%}
<svg class="btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
{%- endmacro %}

{% macro icon_plus() -%}
<svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
{%- endmacro %}

{% macro stitch_divider() -%}
<div class="stitch-divider" aria-hidden="true">
  <svg viewBox="0 0 220 12" fill="none" xmlns="http://www.w3.org/2000/svg">
    <line x1="0" y1="6" x2="220" y2="6" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 7" stroke-linecap="round"/>
  </svg>
</div>
{%- endmacro %}

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ business.seo.title }}</title>
<meta name="description" content="{{ business.seo.description }}">
<meta name="keywords" content="{{ business.seo.keywords | join(', ') }}">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#5c3a24">

<meta property="og:type" content="business.business">
<meta property="og:locale" content="ja_JP">
<meta property="og:title" content="{{ business.seo.title }}">
<meta property="og:description" content="{{ business.seo.description }}">
<meta property="og:site_name" content="{{ business.brand.name }}">

<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='32' fill='%235c3a24'/%3E%3Ctext x='32' y='42' font-family='Georgia,serif' font-size='30' fill='%23f2e9db' text-anchor='middle'%3ET%3C/text%3E%3C/svg%3E">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Zen+Old+Mincho:wght@600&display=swap" rel="stylesheet">

<link rel="stylesheet" href="css/style.css">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "{{ business.brand.name }}",
  "description": "{{ business.seo.description }}",
  "telephone": "+81-42-550-0591",
  "address": {
    "@type": "PostalAddress",
    "postalCode": "{{ business.address.postalCode }}",
    "addressRegion": "{{ business.address.prefecture }}",
    "addressLocality": "{{ business.address.city }}",
    "streetAddress": "{{ business.address.line1 }} {{ business.address.building }}",
    "addressCountry": "JP"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Friday", "Saturday", "Sunday"],
    "opens": "{{ business.hours.opensTime }}",
    "closes": "{{ business.hours.closesTime }}"
  }
}
</script>
</head>
<body class="has-sticky-cta">

<a class="skip-link" href="#main">本文へスキップ</a>

<div class="demo-banner">
  これは営業提案用のデモサイトです（店舗公式サイトではありません）
</div>

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="#main">{{ business.brand.nameShort }}</a>
    <a class="btn btn--primary site-header__cta" href="tel:{{ business.contact.phoneTel }}">
      {{ icon_phone() }}
      電話で相談する
    </a>
  </div>
</header>

<main id="main">

  {# ===================== SECTION 1: ヒーロー ===================== #}
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="container">
      <p class="hero__label">{{ business.brand.nameShort }}</p>
      <h1 class="hero__title">
        <span>大切なものを、</span>
        <span>もう一度使えるように。</span>
      </h1>
      <p class="hero__desc">
        靴・鞄・財布・革製品・傘の修理から合鍵作製まで。
        品物の状態を確認しながら、修理についてご案内します。
      </p>
      <p class="hero__location">
        {{ icon_pin() }}
        {{ business.address.building }}（{{ business.address.city }}{{ business.address.line1 }}）
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--block" href="tel:{{ business.contact.phoneTel }}">
          {{ icon_phone() }}
          電話で相談する
        </a>
        <span class="hero__phone-number">{{ business.contact.phoneDisplay }}</span>
      </div>
      <p class="hero__meta">
        <span>営業時間 <strong>{{ business.hours.display }}</strong></span>
        <span><strong>{{ business.hours.closedDayShort }}</strong>定休</span>
      </p>
    </div>
  </section>

  {{ stitch_divider() }}

  {# ===================== SECTION 2: お困りごと ===================== #}
  <section class="section section--alt" aria-labelledby="troubles-title">
    <div class="container">
      <div class="section__header fade-in">
        <p class="section__eyebrow">TROUBLE</p>
        <h2 class="section__title" id="troubles-title">こんなお困りごとはありませんか？</h2>
      </div>
      <div class="trouble-grid">
        {% for t in business.troubles %}
        <div class="trouble-card fade-in">
          <span class="trouble-card__index">{{ "%02d"|format(loop.index) }}</span>
          <h3 class="trouble-card__title">{{ t.title }}</h3>
          <p class="trouble-card__desc">{{ t.desc }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# ===================== SECTION 3: 対応サービス ===================== #}
  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section__header fade-in">
        <p class="section__eyebrow">SERVICE</p>
        <h2 class="section__title" id="services-title">対応サービス</h2>
        <p class="section__lead">靴修理を中心に、鞄・財布・革製品・傘の修理、合鍵作製まで幅広く対応しています。</p>
      </div>
      <div class="service-grid">
        {% for s in business.serviceCards %}
        <div class="service-card fade-in">
          <h3 class="service-card__title">{{ s.title }}</h3>
          <p class="service-card__desc">{{ s.desc }}</p>
        </div>
        {% endfor %}
      </div>
      <p class="price-note fade-in">
        料金については、状態や修理内容によって異なります。まずは店舗でご相談ください。
      </p>
    </div>
  </section>

  {# ===================== SECTION 4: 店舗の特徴 ===================== #}
  <section class="section section--alt" aria-labelledby="features-title">
    <div class="container">
      <div class="section__header fade-in">
        <p class="section__eyebrow">FEATURE</p>
        <h2 class="section__title" id="features-title">店舗の特徴</h2>
      </div>
      <div class="feature-list">
        {% for f in business.features %}
        <div class="feature-item fade-in">
          <h3 class="feature-item__title">{{ f.title }}</h3>
          <p class="feature-item__desc">{{ f.desc }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# ===================== SECTION 5: 相談導線 ===================== #}
  <section class="section" aria-labelledby="consult-title">
    <div class="container">
      <div class="consult-band fade-in">
        <h2 class="section__title" id="consult-title">捨てる前に、一度ご相談ください。</h2>
        <p class="consult-band__lead">「こんなものでも直せる？」そんなご相談もお気軽に。</p>
        <p class="consult-band__body">品物の状態を確認しながら、修理についてご案内します。</p>
        <div class="consult-band__actions">
          <a class="btn btn--primary" href="tel:{{ business.contact.phoneTel }}">
            {{ icon_phone() }}
            電話で相談する
          </a>
        </div>
      </div>
    </div>
  </section>

  {# ===================== SECTION 6: FAQ ===================== #}
  <section class="section section--alt" aria-labelledby="faq-title">
    <div class="container">
      <div class="section__header fade-in">
        <p class="section__eyebrow">FAQ</p>
        <h2 class="section__title" id="faq-title">よくあるご質問</h2>
      </div>
      <div class="faq-list">
        {% for item in business.faq %}
        <details class="faq-item fade-in">
          <summary>
            <span>Q. {{ item.q }}</span>
            {{ icon_plus() }}
          </summary>
          <p class="faq-item__answer">{{ item.a }}</p>
        </details>
        {% endfor %}
      </div>
    </div>
  </section>

  {# ===================== SECTION 7: 店舗情報・アクセス ===================== #}
  <section class="section" aria-labelledby="access-title">
    <div class="container">
      <div class="section__header fade-in">
        <p class="section__eyebrow">ACCESS</p>
        <h2 class="section__title" id="access-title">店舗情報・アクセス</h2>
      </div>
      <div class="access-grid">
        <div class="access-panel fade-in">
          <table class="access-table">
            <tbody>
              <tr>
                <th scope="row">店舗名</th>
                <td>{{ business.brand.name }}</td>
              </tr>
              <tr>
                <th scope="row">住所</th>
                <td>{{ business.address.fullWithPostal }}</td>
              </tr>
              <tr>
                <th scope="row">電話</th>
                <td><a href="tel:{{ business.contact.phoneTel }}">{{ business.contact.phoneDisplay }}</a></td>
              </tr>
              <tr>
                <th scope="row">営業時間</th>
                <td>{{ business.hours.display }}</td>
              </tr>
              <tr>
                <th scope="row">定休日</th>
                <td>{{ business.hours.closedDay }}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="access-map-card fade-in">
          <h3 class="access-map-card__title">地図で見る</h3>
          <p class="access-map-card__desc">{{ business.address.building }}（{{ business.address.city }}{{ business.address.line1 }}）</p>
          <a class="btn btn--outline" href="{{ business.googleMapsUrl }}" target="_blank" rel="noopener noreferrer">
            {{ icon_pin() }}
            Google Mapsで見る
          </a>
        </div>
      </div>
    </div>
  </section>

  {# ===================== SECTION 8: 最終CTA ===================== #}
  <section class="section section--alt final-cta" aria-labelledby="final-cta-title">
    <div class="container">
      <h2 class="section__title" id="final-cta-title">
        修理できるか迷ったら、<br>まずはお気軽にご相談ください。
      </h2>
      <div class="final-cta__actions">
        <a class="btn btn--primary" href="tel:{{ business.contact.phoneTel }}">
          {{ icon_phone() }}
          {{ business.contact.phoneDisplay }} に電話する
        </a>
      </div>
    </div>
  </section>

</main>

<footer class="site-footer">
  <div class="container">
    <p class="site-footer__brand">{{ business.brand.name }}</p>
    <p class="site-footer__row">
      <span>{{ business.address.fullWithPostal }}</span>
    </p>
    <p class="site-footer__row">
      <span>TEL {{ business.contact.phoneDisplay }}</span>
      <span>営業時間 {{ business.hours.display }}</span>
      <span>{{ business.hours.closedDay }}定休</span>
    </p>
    <p class="site-footer__disclaimer">
      本サイトはWebサイト制作提案用のデモページです。店舗公式サイトではありません。<br>
      掲載内容は公開情報をもとに作成した参考情報であり、正式な情報は必ず店舗へお問い合わせのうえご確認ください。
    </p>
  </div>
</footer>

<div class="mobile-cta">
  <a class="btn btn--primary btn--block" href="tel:{{ business.contact.phoneTel }}">
    {{ icon_phone() }}
    電話する（{{ business.contact.phoneDisplay }}）
  </a>
</div>

<script src="js/main.js" defer></script>
</body>
</html>
